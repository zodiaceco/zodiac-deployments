{
  "name": "@zodiaceco/deployments",
  "version": "6.0.0",
  "description": "Zodiac is a composable design philosophy and collection of standards for building DAO ecosystem tooling.",
  "author": "Auryn Macmillan <auryn@gnosisguild.org>",
  "license": "LGPL-3.0+",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./mastercopies/*": "./mastercopies/*",
    "./package.json": "./package.json"
  },
  "files": [
    "package.json",
    "LICENSE",
    "README.md",
    "dist",
    "mastercopies",
    "!mastercopies/**/source.json"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "bun run abigen",
    "build": "bun run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json",
    "postbuild": "bun postbuild.mjs",
    "cli": "bun src/cli/main.ts",
    "abigen": "bun src/cli/main.ts abigen",
    "extract": "bun src/cli/main.ts extract",
    "deploy": "bun src/cli/main.ts deploy",
    "deploy:list": "bun src/cli/main.ts deploy list",
    "verify": "bun src/cli/main.ts verify",
    "verify:list": "bun src/cli/main.ts verify list",
    "format": "prettier --write ./src/**/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zodiaceco/zodiac-deployments.git"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/semver": "^7.7.1",
    "eth-provider": "^0.13.7",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "viem": "^2.58.0"
  },
  "dependencies": {
    "semver": "^7.7.3"
  },
  "packageManager": "bun@1.4.5"
}
